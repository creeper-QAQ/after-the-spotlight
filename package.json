{
  "name": "after-the-spotlight",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/versions.mjs save before-dev",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/versions.mjs save before-build",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "backup": "node scripts/versions.mjs save",
    "versions": "node scripts/versions.mjs list",
    "restore": "node scripts/versions.mjs restore",
    "test:versions": "node --test tests/versions.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:ai-reply": "node tests/ai-reply.mjs",
    "test:evidence": "node tests/public-evidence.mjs && node tests/submission-facts.mjs",
    "test:coverage": "node tests/coverage-reader.mjs",
    "test:delivery": "node tests/submission-package.mjs",
    "delivery": "node scripts/delivery.mjs",
    "test:scroll": "node tests/scroll.mjs",
    "format": "prettier --write src scripts tests vite.config.ts",
    "format:check": "prettier --check src scripts tests vite.config.ts",
    "test:effects": "node tests/effects.mjs",
    "test:games": "node tests/games.mjs",
    "test:corpus": "node tests/corpus-audit.mjs && node tests/corpus-reader.mjs",
    "test:media": "node tests/submission-media.mjs",
    "test:reply": "node --test tests/local-reply.test.mjs && node tests/local-reply-browser.mjs",
    "test:story": "node tests/question-led-story.mjs"
  },
  "dependencies": {
    "@remotion/player": "^4.0.506",
    "@types/matter-js": "^0.20.2",
    "3d-force-graph": "1.80.0",
    "gsap": "3.15.0",
    "matter-js": "^0.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.506",
    "three": "0.186.0",
    "webgl-fluid-enhanced": "0.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
